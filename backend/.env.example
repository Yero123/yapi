# Copy to backend/.env for local development. Never commit the copy.

DATABASE_URL=postgresql+psycopg://yapi:yapi@localhost:5432/yapi
CORS_ORIGINS=http://localhost:5173

# Assistant. Leave the key empty to run without it.
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2

# Optional limits (defaults shown)
# CHAT_MAX_MESSAGE_CHARS=1000
# CHAT_RATE_LIMIT_PER_MINUTE=20
# CHAT_HISTORY_WINDOW=20
